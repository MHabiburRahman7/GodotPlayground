config_version=5

[application]

config/name="ProjectO"
run/main_scene="uid://dup7s54vwgrrs"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Global="*res://Script/Global.gd"
InventorySystemSingleton="*res://Script/Inventory/InventorySystem.gd"
OrderSystemSingleton="*res://Script/OnlineStuff/AutoLoad/OrderSystem.gd"
SupplySystemSingleton="*res://Script/OnlineStuff/AutoLoad/SupplySystem.gd"
InboxSystemSingleton="*res://Script/OnlineStuff/Manager/InboxSystem.gd"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="ProjectO"

[editor]

version_control/autoload_on_startup=true

